generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Dedupes mutations replayed by the offline queue: the client sends a stable
// Idempotency-Key header, recorded here on first success so replays are no-ops.
model IdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now())

  @@map("idempotency_keys")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
  vehicles  Vehicle[]
  drivers   Driver[]
  trips     Trip[]
  fuelLogs  FuelLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  driver       Driver?
  tripsCreated Trip[]   @relation("TripCreatedBy")
  costs        TripCost[]
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String   // create | update | delete | start | complete | cancel | respond | ...
  entity     String   // trip | vehicle | driver | fuel_log | maintenance | checklist | user | ...
  entityId   String?
  method     String
  path       String
  statusCode Int
  summary    String?  // sanitized JSON snapshot of the request body
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

model Vehicle {
  id        String   @id @default(uuid())
  tenantId  String
  plate     String
  model     String
  brand     String
  year      Int
  type      String
  currentKm Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  trips            Trip[]
  kmLogs           KmLog[]
  fuelLogs         FuelLog[]
  maintenances     VehicleMaintenance[]
  maintenancePlans MaintenancePlan[]

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@map("vehicles")
}

model VehicleMaintenance {
  id              String   @id @default(uuid())
  tenantId        String
  vehicleId       String
  type            String
  description     String
  performedAt     DateTime
  kmAtService     Int
  cost            Decimal? @db.Decimal(10, 2)
  nextServiceKm   Int?
  nextServiceDate DateTime?
  notes           String?
  photoUrl        String?
  createdBy       String
  createdAt       DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@map("vehicle_maintenances")
}

// Preventive maintenance schedule: per-vehicle, per-type recurring interval.
// The next due is computed from the latest VehicleMaintenance of the same type.
model MaintenancePlan {
  id           String   @id @default(uuid())
  tenantId     String
  vehicleId    String
  type         String
  intervalKm   Int?
  intervalDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, type])
  @@index([tenantId, vehicleId])
  @@map("maintenance_plans")
}

model Driver {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?  @unique
  name         String
  cpf          String
  cnhNumber    String
  cnhCategory  String
  cnhExpiresAt DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])
  trips        Trip[]
  kmLogs       KmLog[]
  fuelLogs     FuelLog[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@map("drivers")
}

model Trip {
  id                 String    @id @default(uuid())
  tenantId           String
  driverId           String
  vehicleId          String
  originAddress      String
  originLat          Decimal?  @db.Decimal(10, 7)
  originLng          Decimal?  @db.Decimal(10, 7)
  destinationAddress String
  destinationLat     Decimal?  @db.Decimal(10, 7)
  destinationLng     Decimal?  @db.Decimal(10, 7)
  status             String    @default("draft")
  kmStart            Int
  kmEnd              Int?
  startedAt          DateTime?
  completedAt        DateTime?
  departureTime      DateTime?
  arrivalTime        DateTime?
  cartaFrete         Decimal?  @db.Decimal(10, 2)
  pesoCarga          Decimal?  @db.Decimal(10, 3)
  adiantamento       Decimal?  @db.Decimal(10, 2)
  notes              String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  driver             Driver    @relation(fields: [driverId], references: [id])
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id])
  creator            User      @relation("TripCreatedBy", fields: [createdBy], references: [id])
  costs              TripCost[]
  kmLogs             KmLog[]
  checklists         TripChecklist[]
  fuelLogs           FuelLog[]

  @@index([tenantId, status])
  @@index([tenantId, driverId])
  @@map("trips")
}

model TripCost {
  id          String   @id @default(uuid())
  tenantId    String
  tripId      String
  category    String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  receiptUrl  String?
  paidAt      DateTime
  createdBy   String
  createdAt   DateTime @default(now())

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [createdBy], references: [id])

  @@index([tenantId, tripId])
  @@map("trip_costs")
}

model KmLog {
  id                 String   @id @default(uuid())
  tenantId           String
  tripId             String
  vehicleId          String
  driverId           String
  kmStart            Int
  kmEnd              Int?
  photoOdometerUrl   String?
  loggedAt           DateTime @default(now())
  eventType          String

  trip               Trip     @relation(fields: [tripId], references: [id])
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id])
  driver             Driver   @relation(fields: [driverId], references: [id])

  @@index([tenantId, tripId])
  @@index([tenantId, vehicleId])
  @@map("km_logs")
}

model ChecklistTemplate {
  id        String          @id @default(uuid())
  tenantId  String
  name      String
  type      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  items     ChecklistItem[]
  instances TripChecklist[]

  @@index([tenantId])
  @@map("checklist_templates")
}

model ChecklistItem {
  id          String            @id @default(uuid())
  templateId  String
  description String
  isRequired  Boolean           @default(true)
  orderIndex  Int

  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses   ChecklistResponse[]

  @@map("checklist_items")
}

model TripChecklist {
  id          String             @id @default(uuid())
  tenantId    String
  tripId      String
  templateId  String
  type        String
  completedBy String?
  completedAt DateTime?
  createdAt   DateTime           @default(now())

  trip        Trip               @relation(fields: [tripId], references: [id])
  template    ChecklistTemplate  @relation(fields: [templateId], references: [id])
  responses   ChecklistResponse[]

  @@index([tenantId, tripId])
  @@map("trip_checklists")
}

model ChecklistResponse {
  id              String        @id @default(uuid())
  tripChecklistId String
  itemId          String
  passed          Boolean
  notes           String?
  photoUrl        String?

  checklist       TripChecklist @relation(fields: [tripChecklistId], references: [id], onDelete: Cascade)
  item            ChecklistItem @relation(fields: [itemId], references: [id])

  @@unique([tripChecklistId, itemId])
  @@map("checklist_responses")
}

model FuelLog {
  id            String   @id @default(uuid())
  tenantId      String
  vehicleId     String
  driverId      String
  tripId        String?
  loggedAt      DateTime
  fuelType      String
  liters        Decimal  @db.Decimal(10, 3)
  pricePerLiter Decimal  @db.Decimal(10, 4)
  totalAmount   Decimal  @db.Decimal(10, 2)
  station       String?
  receiptUrl    String?
  kmAtFueling   Int
  kmPerLiter    Decimal? @db.Decimal(10, 3)
  createdAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  driver   Driver   @relation(fields: [driverId], references: [id])
  trip     Trip?    @relation(fields: [tripId], references: [id])

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@map("fuel_logs")
}
