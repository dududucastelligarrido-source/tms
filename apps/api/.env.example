DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tms_dev"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/tms_test"
JWT_SECRET="change-me-in-production-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-at-least-32-chars"
CORS_ORIGIN="http://localhost:5173"

# File storage (Cloudflare R2, AWS S3 ou compatível com S3)
# Cloudflare R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# AWS S3:        S3_ENDPOINT="https://s3.<region>.amazonaws.com"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="tms-uploads"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
# URL pública dos arquivos (R2 custom domain ou URL pública do bucket)
S3_PUBLIC_URL="https://uploads.seu-dominio.com"

# Email (Resend) — alertas de CNH/manutenção
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="TMS Alertas <alertas@seu-dominio.com>"
# Secret compartilhado para o cron job de alertas (header x-cron-secret)
CRON_SECRET="gere-um-secret-aleatorio-forte"
